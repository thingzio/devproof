# =============================================================================
# Build & Release
# =============================================================================
dist/

# Where the shared release workflow (thingzio/actions release-go.yaml) checks
# itself out -- inside the workspace, because its Build job runs a local
# composite action and those must live under GITHUB_WORKSPACE. goreleaser
# refuses to build from a tree with untracked files.
#
# Redundant as of release-go v1.7.1, which adds /.builder/ to .git/info/exclude
# itself. Kept as a cheap guard: this costs one line and still holds if the pin
# is ever rolled back to a version without that fix.
.builder/

# Ko
.digest

# Cosign / Signing
cosign.*
*.pem
# Offline verification fixtures are committed on purpose: the evidence and
# policy suites must run without a network-dependent identity service, and
# their trust material is PEM. Keep this negation below the *.pem rule.
!testdata/**/*.pem
!**/testdata/**/*.pem

# SBOM
sbom.json

# Test reports
report.xml
coverage.xml

# Image digests
digests.txt
images.json


