#!/usr/bin/env python3
"""Enforce per-package coverage floors against a Go coverage profile.

Run from the repo root, or via `make cover-check`.

A single repository-wide floor is a number that can be met by testing the easy
packages. The packages where a gap is dangerous are not the ones where coverage
is cheap: an untested branch in expansion writes a file somewhere it should
not, and an untested branch in policy evaluation reports "pass".

Each floor below is set just under the package's current coverage, so it
ratchets. Raise one when coverage improves; never lower one to make a red build
green. A package with no floor is covered by the repository-wide threshold in
.versions.yaml and nothing else.
"""

import collections
import pathlib
import subprocess
import sys

# Package path (module-relative) -> minimum percentage, with the reason the
# package is on this list at all.
FLOORS = {
    # Decides what gets written to disk and what a caller is told about it.
    "pkg/devproof": 75,
    # Decides whether evidence satisfies a policy. An untested branch here
    # reports "pass".
    "pkg/policy": 78,
    # Writes to the filesystem from somebody else's archive. Every path rule
    # that is not exercised is a path that might escape the destination.
    "internal/safefs": 80,
    # Speaks to registries, which are the untrusted side of every operation.
    "internal/oci": 78,
    # Produces the bytes that are the artifact's identity.
    "internal/canonical": 85,
    # The independent reader. A gap here is a conformance claim nobody checked.
    "pkg/conformance": 78,
    # The document types every other package is built on.
    "pkg/bundle": 90,
}

MODULE = "github.com/thingzio/devproof/"


def coverage_by_package(profile: pathlib.Path) -> dict[str, float]:
    """Return mean statement coverage per package."""
    report = subprocess.run(
        ["go", "tool", "cover", f"-func={profile}"],
        capture_output=True,
        text=True,
        check=True,
    ).stdout

    totals: dict[str, list[float]] = collections.defaultdict(list)
    for line in report.splitlines():
        fields = line.split()
        if len(fields) < 3 or fields[0].startswith("total:"):
            continue
        path = fields[0].split(":")[0]
        package = path.rsplit("/", 1)[0].removeprefix(MODULE)
        totals[package].append(float(fields[-1].rstrip("%")))

    return {name: sum(values) / len(values) for name, values in totals.items()}


def main() -> int:
    profile = pathlib.Path(sys.argv[1] if len(sys.argv) > 1 else "coverage.out")
    if not profile.exists():
        print(f"{profile} does not exist; run the tests first", file=sys.stderr)
        return 1

    measured = coverage_by_package(profile)
    failures = []

    for package, floor in sorted(FLOORS.items()):
        got = measured.get(package)
        if got is None:
            # A package that vanished from the profile is a floor nobody is
            # enforcing, which looks exactly like a floor being met.
            failures.append(f"{package}: absent from the coverage profile")
            continue
        status = "ok " if got >= floor else "LOW"
        print(f"{status} {package:<28} {got:5.1f}%  (floor {floor}%)")
        if got < floor:
            failures.append(f"{package}: {got:.1f}% is below the {floor}% floor")

    if failures:
        print("", file=sys.stderr)
        for failure in failures:
            print(f"coverage floor not met: {failure}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
