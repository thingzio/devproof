#!/usr/bin/env python3
"""Regenerate THIRD_PARTY_NOTICES.md from the modules actually linked in.

Run from the repo root, or via `make notices`.

DevProof does not vendor, so this repository does not redistribute dependency
source. It does ship compiled binaries, and a Go binary statically links its
dependencies -- so the released artifacts *do* redistribute that code, and the
Apache-2.0 section 4 obligation to carry licenses and NOTICE files applies to
them.

The module set is taken from the build graph (`go list -deps`), not from
`go list -m all`. The latter reports every module in the requirement graph --
around 400 here -- most of which are test-only dependencies of dependencies that
never reach a binary. Listing those would overstate what is redistributed.
"""

import json
import pathlib
import re
import subprocess
import sys

ROOT = pathlib.Path.cwd()
OUT = ROOT / "THIRD_PARTY_NOTICES.md"
# Glob rather than a fixed list: modules use COPYING.md, LICENSE.BSD, and other
# variants that a hardcoded tuple silently misses.
LICENSE_GLOBS = ("LICENSE*", "LICENCE*", "COPYING*")

DETECTORS = [
    ("Apache-2.0", re.compile(r"Apache License,?\s*\n?\s*Version 2\.0", re.I)),
    ("MPL-2.0", re.compile(r"Mozilla Public License,?\s+[Vv]ersion 2\.0", re.I)),
    ("ISC", re.compile(r"Permission to use, copy, modify, and/or distribute", re.I)),
    ("BSD-3-Clause", re.compile(r"Redistribution and use.*?Neither the name", re.I | re.S)),
    ("BSD-2-Clause", re.compile(r"Redistribution and use in source and binary forms", re.I)),
    ("MIT", re.compile(r"Permission is hereby granted, free of charge", re.I)),
]


def detect(text):
    for name, pat in DETECTORS:
        if pat.search(text):
            return name
    return "See license text"


def find_license(d):
    for pattern in LICENSE_GLOBS:
        for p in sorted(d.glob(pattern)):
            if p.is_file():
                return p
    return None


def linked_modules():
    """Modules contributing packages to the buildable commands and library."""
    out = subprocess.run(
        ["go", "list", "-deps", "-json", "./..."],
        capture_output=True, text=True, check=True,
    ).stdout
    mods, dec, idx = {}, json.JSONDecoder(), 0
    while idx < len(out):
        while idx < len(out) and out[idx].isspace():
            idx += 1
        if idx >= len(out):
            break
        obj, idx = dec.raw_decode(out, idx)
        m = obj.get("Module")
        if not m or m.get("Main") or not m.get("Dir"):
            continue
        mods[m["Path"]] = (m.get("Version", ""), pathlib.Path(m["Dir"]))
    return dict(sorted(mods.items()))


def main():
    if not (ROOT / "go.mod").is_file():
        sys.exit("no go.mod -- run from the repo root")

    mods = linked_modules()
    rows, texts, notices, missing = [], {}, [], []

    for path, (version, d) in mods.items():
        lic = find_license(d)
        if lic is None:
            missing.append(path)
            rows.append((path, version, "not found"))
            continue
        body = lic.read_text(errors="replace")
        ident = detect(body)
        rows.append((path, version, ident))
        texts.setdefault(ident, (path, body))
        for nname in ("NOTICE", "NOTICE.txt", "NOTICE.md"):
            n = lic.parent / nname
            if n.is_file():
                notices.append((path, n.read_text(errors="replace").strip()))
                break

    out = ["# Third-party notices\n"]
    out.append(
        "DevProof does not vendor its dependencies, so this repository does not\n"
        "redistribute their source. Released binaries statically link them, so the\n"
        "**released artifacts** do, and their licenses and attributions are reproduced\n"
        "here.\n"
    )
    out.append(
        "\n> Generated by `tools/gen-third-party-notices` from the build graph.\n"
        "> Do not edit by hand -- run `make notices` after changing dependencies.\n"
    )
    out.append(f"\n## Dependencies ({len(rows)})\n")
    out.append("| Module | Version | License |")
    out.append("|---|---|---|")
    for path, version, ident in rows:
        out.append(f"| `{path}` | {version} | {ident} |")

    if notices:
        out.append("\n## NOTICE files\n")
        out.append("Reproduced verbatim, as required by Apache-2.0 section 4(d).\n")
        for path, body in sorted(notices):
            out.append(f"\n### `{path}`\n\n```\n{body}\n```")

    out.append("\n## License texts\n")
    out.append(
        "One copy of each distinct license, with a representative module named.\n"
    )
    for ident in sorted(texts):
        rep, body = texts[ident]
        out.append(f"\n### {ident}\n\nRepresentative module: `{rep}`\n")
        out.append(f"```\n{body.strip()}\n```")

    OUT.write_text("\n".join(out) + "\n")
    print(f"wrote {OUT.name}: {len(rows)} modules, {len(texts)} distinct licenses, "
          f"{len(notices)} NOTICE files")
    if missing:
        print(f"WARNING: no license found for {len(missing)} module(s):", file=sys.stderr)
        for m in missing:
            print(f"  {m}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
